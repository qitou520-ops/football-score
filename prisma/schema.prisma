generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         String   @default("admin")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("admins")
}

model NewsArticle {
  id             String    @id @default(cuid())
  slug           String    @unique
  titleEn        String    @db.Text
  titleZh        String    @db.Text
  excerptEn      String    @db.Text
  excerptZh      String    @db.Text
  contentEn      String    @db.LongText
  contentZh      String    @db.LongText
  coverImage     String?
  seoTitle       String?   @db.Text
  seoDescription String?   @db.Text
  category       String    @default("news")
  published      Boolean   @default(false)
  publishedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([published, publishedAt])
  @@map("news")
}

model PredictionArticle {
  id          String    @id @default(cuid())
  slug        String    @unique
  titleEn     String    @db.Text
  titleZh     String    @db.Text
  excerptEn   String    @db.Text
  excerptZh   String    @db.Text
  contentEn   String    @db.LongText
  contentZh   String    @db.LongText
  coverImage  String?
  matchId     Int?
  leagueId    Int?
  confidence  Int       @default(50)
  prediction  String?
  published   Boolean   @default(false)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([published, publishedAt])
  @@map("predictions")
}

model AdSlot {
  id        String   @id @default(cuid())
  name      String   @unique
  title     String?
  position  String
  provider  String   @default("custom")
  htmlCode  String   @db.Text
  imageUrl  String?
  linkUrl   String?
  active    Boolean  @default(true)
  priority  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("ads")
}

model FeaturedMatch {
  id        String   @id @default(cuid())
  matchId   Int
  sortOrder Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active, sortOrder])
  @@map("featured_matches")
}

model ApiLog {
  id         String   @id @default(cuid())
  endpoint   String
  method     String   @default("GET")
  statusCode Int?
  durationMs Int?
  cached     Boolean  @default(false)
  error      String?  @db.Text
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([endpoint, createdAt])
  @@map("api_logs")
}

model AffiliateLink {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  destination String   @db.Text
  partner     String
  active      Boolean  @default(true)
  clicks      Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  clickEvents AffiliateClick[]
}

model AffiliateClick {
  id        String        @id @default(cuid())
  linkId    String
  link      AffiliateLink @relation(fields: [linkId], references: [id], onDelete: Cascade)
  ipHash    String?
  userAgent String?       @db.Text
  referer   String?       @db.Text
  createdAt DateTime      @default(now())

  @@index([linkId, createdAt])
}

model SiteSetting {
  id    String @id @default(cuid())
  key   String @unique
  value String @db.Text
}

model TelegramChannel {
  id          String   @id @default(cuid())
  channelName String
  channelUrl  String
  botToken    String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
